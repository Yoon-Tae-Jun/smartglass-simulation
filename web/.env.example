# 백엔드 API 주소 (WebSocket 주소는 http→ws 자동 변환)
VITE_API_BASE=http://localhost:8000

# 네이버 지도 클라이언트 ID (길찾기 미니 지도용)
# 네이버 클라우드 콘솔 > Maps > Web Dynamic Map 등록 후 발급되는 Client ID.
# 서비스 URL에 http://localhost:5173 (5174 등 실제 dev 포트)를 등록해야 로드된다.
# 없으면 미니 지도는 '지도 키 미설정' 폴백으로 표시되고 경로 정보는 정상 동작한다.
VITE_NAVER_MAP_CLIENT_ID=
