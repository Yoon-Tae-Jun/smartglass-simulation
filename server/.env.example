# server/.env.example
# 이 파일을 server/.env로 복사한 뒤 실제 키를 채운다 (.env는 커밋 금지)

# ---------------- map (네이버 지도) ----------------
MAP_CLIENT_ID=
MAP_SECRET_KEY=
GEOCODE_URL=
REVERSE_GEOCODE_URL=
DIRECTIONS_URL=

LOCAL_SEARCH_URL=
LOCAL_SEARCH_CLIENT_ID=
LOCAL_SEARCH_SECRET_KEY=

# ---------------- stt (CLOVA Speech) ----------------
CLOVA_SPEECH_SECRET=
CLOVA_SPEECH_INVOKE_URL=

# ---------------- imgPapago (파파고 이미지 번역) ----------------
# 고정 엔드포인트 (Image Translation(Image) — 번역문을 합성한 이미지를 돌려주는 쪽)
IMG_TRANSLATE_URL=https://papago.apigw.ntruss.com/image-to-image/v1/translate
PAPAGO_CLIENT_ID=
PAPAGO_SECRET_KEY=
